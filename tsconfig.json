{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "removeComments": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@shared": [
        "./src/shared"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./src/@types"
    ],
    "types": [
      "node",
      "express",
      "bcrypt",
      "compression",
      "cookie-parser",
      "cors",
      "express-sslify",
      "hpp",
      "jsonwebtoken",
      "morgan",
      "ms",
      "multer",
      "node-cron",
      "pg",
      "qrcode",
      "react",
      "react-dom",
      "sanitize-html"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}