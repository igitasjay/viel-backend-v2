    "watcher:bitcoin": "node dist/crypto-infra/workers/bitcoin-watcher.js",
    "sweeper": "node dist/crypto-infra/workers/sweep-worker.js",
    "sweep:test": "tsx src/crypto-infra/workers/test-sweep.ts",
    "start:all": "concurrently \"node dist/server.js\" \"pnpm run watcher\" \"pnpm run watcher:solana\" \"pnpm run watcher:bitcoin\" \"pnpm run sweeper\""
