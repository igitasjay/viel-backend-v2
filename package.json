{
  "name": "blog-ts",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc && tscpaths -p tsconfig.json -s ./src -o ./dist",
    "start": "node dist/server.js",
    "dev": "nodemon",
    "seed:crypto": "ts-node -r tsconfig-paths/register src/seed/crypto-seeds.ts",
    "seed:transaction": "ts-node src/seed/transaction-seeds.ts",
    "watcher:dev": "ts-node -r tsconfig-paths/register src/crypto-infra/workers/evm-watcher.ts",
    "watcher": "node dist/crypto-infra/workers/evm-watcher.js",
    "start:all": "concurrently \"node dist/server.js\" \"node dist/crypto-infra/workers/evm-watcher.js\""
  },
